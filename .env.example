# WriteUp Pro Environment Variables
PROJECT_NAME="WriteUp Pro"
VERSION="2.0.0"
API_V1_STR="/api/v1"

# Security & Sessions
SECRET_KEY="replace-this-with-a-random-32-byte-hex-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Institutional Identity
INSTITUTION_NAME="Imperial Institute of Engineering & Technology"
INSTITUTION_CODE="IIET-ACAD"
ACADEMIC_YEAR="2026-27"

# Database Configuration
# Local SQLite default:
DATABASE_PATH="writeuppro.db"
# PostgreSQL production alternative:
# DATABASE_URL="postgresql://user:password@localhost:5432/writeuppro"

# Client Anti-Paste & Telemetry Policies
BLOCK_PASTE_DEFAULT=true
BLOCK_EXTERNAL_DROP=true
LOG_FOCUS_SWITCH=true
TYPING_BURST_THRESHOLD_MS=30
TYPING_BURST_MIN_KEYS=15
